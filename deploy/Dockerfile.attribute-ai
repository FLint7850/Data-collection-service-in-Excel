FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG CODEX_VERSION=latest
RUN npm install --global --no-audit --no-fund "@openai/codex@${CODEX_VERSION}"

WORKDIR /app
COPY deploy/attribute-ai-bridge.mjs /app/attribute-ai-bridge.mjs
RUN mkdir -p /state/codex

ENV ATTRIBUTE_AI_HOST=0.0.0.0 \
    ATTRIBUTE_AI_PORT=4580 \
    ATTRIBUTE_CODEX_HOME=/state/codex

EXPOSE 4580
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:4580/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "/app/attribute-ai-bridge.mjs"]

